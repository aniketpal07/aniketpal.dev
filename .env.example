# ── KaalNiti environment variables ──────────────────────────────────────────

# NASA APOD API key — powers the COSMOS WATCH widget on the homepage.
# Get a free key at https://api.nasa.gov — "DEMO_KEY" also works but is rate-limited.
NASA_API_KEY=DEMO_KEY

# GitHub username — public events feed powers the GITHUB PULSE widget.
# No token or auth is required for public repository activity.
GITHUB_USERNAME=aniketpal
