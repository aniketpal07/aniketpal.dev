---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LogEntry from '../components/LogEntry.astro';
import CosmosWatch from '../components/dispatch/CosmosWatch.astro';
import GithubPulse from '../components/dispatch/GithubPulse.astro';
import LatestLog from '../components/dispatch/LatestLog.astro';
import CurrentlyBuilding from '../components/dispatch/CurrentlyBuilding.astro';
import TechStack from '../components/dispatch/TechStack.astro';
import Darkroom from '../components/dispatch/Darkroom.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';

const posts = (await getCollection('logs')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const featured = posts[0];
const rest = posts.slice(1);
const topProjects = projects.slice(0, 2);

const featuredDateline = featured.data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const featuredExcerpt = featured.body
  .replace(/^#+\s.*$/gm, '')
  .replace(/^>\s?/gm, '')
  .replace(/[*_`]/g, '')
  .trim()
  .split(/(?<=[.!?])\s+/)
  .slice(0, 4)
  .join(' ');
---

<BaseLayout title="∞ KaalNiti — Aniket Pal, Backend Engineer">
  <Masthead />

  <!-- Above the fold: asymmetric 3-column broadsheet -->
  <section class="grid grid-cols-1 gap-6 md:grid-cols-12">
    <!-- Lead story -->
    <div class="col-rule md:col-span-7 md:pr-6">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.25em] text-accent">
        The Lead Dispatch · {featured.data.category}
      </p>
      <h2 class="mt-2 font-display text-3xl font-black leading-tight sm:text-5xl">
        <a href={`/logs/${featured.slug}`} class="transition-colors hover:text-accent">
          {featured.data.title}
        </a>
      </h2>
      <p class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-ink-soft">
        {featuredDateline} · By Aniket Pal
      </p>
      <p class="mt-4 text-[1.02rem] leading-relaxed">{featuredExcerpt}</p>
      <p class="mt-4 font-mono text-[0.68rem] uppercase tracking-widest">
        <a href={`/logs/${featured.slug}`} class="text-accent underline underline-offset-4">
          Continue on the inside pages →
        </a>
      </p>
    </div>

    <!-- More from the logs desk -->
    <div class="col-rule md:col-span-3 md:pr-6">
      <p class="border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em] text-ink-soft">
        Also in this edition
      </p>
      {rest.map((entry) => <LogEntry entry={entry} />)}
      <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-widest">
        <a href="/logs" class="text-accent underline underline-offset-4">All logs →</a>
      </p>
    </div>

    <!-- Editor's note -->
    <div class="md:col-span-2">
      <p class="border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em] text-ink-soft">
        The Editor
      </p>
      <p class="mt-3 text-[0.88rem] italic leading-relaxed">
        I write about systems, time, power, and failure. Backend engineering, architecture, and
        ideas that don't care about intent — only consequences.
      </p>
      <p class="mt-3 font-mono text-[0.62rem] uppercase tracking-[0.2em]">— Aniket Pal</p>
      <ul class="mt-4 border-t border-rule-soft pt-3 font-mono text-[0.65rem] uppercase tracking-widest">
        <li class="py-1"><a href="/build" class="hover:text-accent">§ Build</a></li>
        <li class="py-1"><a href="/logs" class="hover:text-accent">§ Logs</a></li>
        <li class="py-1"><a href="/now" class="hover:text-accent">§ Now</a></li>
      </ul>
    </div>
  </section>

  <!-- BUILD: top projects -->
  <SectionHeader kicker="From the workshop floor" title="The Builder's Desk" />
  <section class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {topProjects.map((project) => <ProjectCard project={project} />)}
  </section>
  <p class="mt-5 text-center font-mono text-[0.68rem] uppercase tracking-widest">
    <a href="/build" class="text-accent underline underline-offset-4">
      The complete project archive →
    </a>
  </p>

  <!-- THE DISPATCH: bento grid -->
  <SectionHeader kicker="Live wires & standing columns" title="The Dispatch" />
  <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <CosmosWatch />
    <GithubPulse />
    <LatestLog />
    <CurrentlyBuilding />
    <TechStack />
    <Darkroom />
  </section>

  <Footer />
</BaseLayout>
