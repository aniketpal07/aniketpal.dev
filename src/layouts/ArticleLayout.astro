---
import BaseLayout from './BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: 'LABS' | 'THOUGHTS';
  readingTime: number;
  heroImage?: string;
  heroImageCaption?: string;
}

const { title, description, date, category, readingTime, heroImage, heroImageCaption } =
  Astro.props;
const dateline = date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout title={`${title} — KaalNiti`} description={description}>
  <Masthead />
  <article class="mx-auto max-w-3xl">
    <header class="mb-8 text-center">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.25em] text-ink-soft">
        {category} · {dateline} · {readingTime} min read
      </p>
      <h1 class="mt-3 font-display text-4xl font-black leading-tight sm:text-5xl">{title}</h1>
      <p class="mt-3 italic text-ink-soft">{description}</p>
      <p class="mt-4 font-mono text-[0.62rem] uppercase tracking-[0.25em]">
        By <span class="text-accent">Aniket Pal</span> — Backend Engineer
      </p>
      <div class="section-rule mt-5 h-2"></div>
    </header>
    {heroImage && (
      <figure class="article-hero mb-8">
        <img src={heroImage} alt={title} loading="eager" />
        {heroImageCaption && <figcaption>{heroImageCaption}</figcaption>}
      </figure>
    )}
    <div class="article-body">
      <slot />
    </div>
    <p class="mt-10 font-mono text-[0.68rem] uppercase tracking-[0.25em]">
      <a href="/logs" class="nav-link text-accent">← back to the logs desk</a>
    </p>
  </article>
  <Footer />
</BaseLayout>
