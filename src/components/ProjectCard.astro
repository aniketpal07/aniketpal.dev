---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<details class="project-card border border-rule-soft bg-card p-5">
  <summary>
    <p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-ink-soft">
      {project.year} · The Builder's Desk
    </p>
    <h3 class="mt-1 font-display text-2xl font-bold leading-tight">{project.name}</h3>
    <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{project.lede}</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {project.tags.map((t) => (
        <span class="border border-rule-soft px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-widest">
          {t}
        </span>
      ))}
    </div>
    <p class="card-cta-closed mt-3 font-mono text-[0.65rem] uppercase tracking-widest text-accent">
      ▸ Full story
    </p>
    <p class="card-cta-open mt-3 font-mono text-[0.65rem] uppercase tracking-widest text-accent">
      ▾ Fold it back
    </p>
  </summary>
  <div class="mt-4 border-t border-rule-soft pt-4">
    <p class="text-[0.95rem] leading-relaxed">{project.detail}</p>
    <div class="mt-4 flex gap-4 font-mono text-[0.7rem] uppercase tracking-widest">
      {project.github && (
        <a class="text-accent underline underline-offset-4" href={project.github}>GitHub →</a>
      )}
      {project.docs && (
        <a class="text-accent underline underline-offset-4" href={project.docs}>Docs →</a>
      )}
    </div>
  </div>
</details>
