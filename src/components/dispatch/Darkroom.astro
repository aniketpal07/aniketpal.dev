---
import { photos } from '../../data/darkroom';
---

<article id="darkroom" class="flex flex-col border border-rule-soft bg-card p-4">
  <h3 class="mb-3 border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em]">
    ▣ The Darkroom · Contact Sheet
  </h3>
  <div class="grid flex-1 grid-cols-3 gap-1 border-y-4 border-[var(--ink)] bg-[var(--ink)] py-1">
    {photos.map((p, i) => (
      <a href={`#frame-${i}`} class="block">
        <img
          src={p.src}
          alt={p.alt}
          class="aspect-[3/4] w-full object-cover opacity-90 transition-opacity hover:opacity-100"
          loading="lazy"
        />
      </a>
    ))}
  </div>
  <p class="mt-3 font-mono text-[0.6rem] uppercase tracking-widest text-ink-soft">
    Click a frame to develop · 35mm, mostly
  </p>
</article>

{photos.map((p, i) => (
  <div id={`frame-${i}`} class="lightbox">
    <a href="#darkroom" class="lightbox-close" aria-label="Close lightbox">×</a>
    <figure>
      <img src={p.src} alt={p.alt} loading="lazy" />
      <figcaption>{p.caption}</figcaption>
    </figure>
  </div>
))}
