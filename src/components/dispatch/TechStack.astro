---
const stack = [
  { category: 'Systems', items: ['C++', 'Linux', 'Sockets'] },
  { category: 'Backend', items: ['Node.js', 'Python', 'PostgreSQL'] },
  { category: 'AI/ML', items: ['Ollama', 'ChromaDB', 'Whisper'] },
  { category: 'Infra', items: ['Docker', 'Vercel', 'GitHub Actions'] },
];
---

<article class="flex flex-col border border-rule-soft bg-card p-4">
  <h3 class="mb-3 border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em]">
    § Index · Tech Stack
  </h3>
  <div class="grid grid-cols-2 gap-x-4 gap-y-3">
    {stack.map((group) => (
      <div>
        <p class="font-display text-sm font-bold">{group.category}</p>
        <ul class="mt-1">
          {group.items.map((item) => (
            <li class="py-0.5 font-mono text-[0.68rem] tracking-wide text-ink-soft">
              · {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</article>
