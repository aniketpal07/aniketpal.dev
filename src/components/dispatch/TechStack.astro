---
// Two counter-scrolling marquee rows; each row is duplicated so the
// pure-CSS translateX(-50%) loop is seamless.
const rowOne = ['C++', 'Linux', 'Sockets', 'epoll', 'Node.js', 'Python', 'PostgreSQL', 'FastAPI'];
const rowTwo = ['Ollama', 'ChromaDB', 'Whisper', 'Docker', 'Vercel', 'GitHub Actions', 'Astro', 'TypeScript'];
---

<article class="flex flex-col border border-rule-soft bg-card p-4">
  <h3 class="mb-3 border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em]">
    § Index · Tech Stack
  </h3>
  <div class="marquee-mask flex flex-1 flex-col justify-center gap-4 py-2">
    <div class="marquee">
      <div class="marquee-track marquee-reverse">
        {[...rowOne, ...rowOne].map((item) => (
          <span class="marquee-item">{item}</span>
        ))}
      </div>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        {[...rowTwo, ...rowTwo].map((item) => (
          <span class="marquee-item">{item}</span>
        ))}
      </div>
    </div>
  </div>
  <p class="mt-3 font-mono text-[0.6rem] uppercase tracking-widest text-ink-soft">
    The standing type · Hover to pause
  </p>
</article>
