---
interface TechItem {
  name: string;
  icon?: string;
  glyph?: string;
}

const items: TechItem[] = [
  { name: 'C++', icon: 'https://cdn.simpleicons.org/cplusplus/ffffff' },
  { name: 'Linux', icon: 'https://cdn.simpleicons.org/linux/ffffff' },
  { name: 'Python', icon: 'https://cdn.simpleicons.org/python/ffffff' },
  { name: 'Node.js', icon: 'https://cdn.simpleicons.org/nodedotjs/ffffff' },
  { name: 'PostgreSQL', icon: 'https://cdn.simpleicons.org/postgresql/ffffff' },
  { name: 'FastAPI', icon: 'https://cdn.simpleicons.org/fastapi/ffffff' },
  { name: 'Docker', icon: 'https://cdn.simpleicons.org/docker/ffffff' },
  { name: 'GitHub', icon: 'https://cdn.simpleicons.org/github/ffffff' },
  { name: 'TypeScript', icon: 'https://cdn.simpleicons.org/typescript/ffffff' },
  { name: 'Astro', icon: 'https://cdn.simpleicons.org/astro/ffffff' },
  { name: 'Ollama', glyph: '○' },
  { name: 'ChromaDB', glyph: '◈' },
];
---

<article class="flex flex-col border border-rule-soft bg-card p-4">
  <h3 class="mb-3 border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em]">
    § Index · Tech Stack
  </h3>
  <div class="grid flex-1 grid-cols-4 content-center justify-items-center gap-2">
    {items.map((t) => (
      <div class="tech-cell" title={t.name}>
        {t.icon ? (
          <img src={t.icon} alt={t.name} class="tech-icon" loading="lazy" width="28" height="28" />
        ) : (
          <span class="tech-glyph" aria-label={t.name}>{t.glyph}</span>
        )}
        <span class="tech-tape" aria-hidden="true">{t.name}</span>
      </div>
    ))}
  </div>
  <p class="mt-3 font-mono text-[0.6rem] uppercase tracking-widest text-ink-soft">
    The standing type · Hover for the label
  </p>
</article>
