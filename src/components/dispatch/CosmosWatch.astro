---
import { fetchApod } from '../../lib/nasa';

const apod = await fetchApod();
---

<article class="flex flex-col border border-rule-soft bg-card p-4">
  <h3 class="mb-3 border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em]">
    ✦ Cosmos Watch
  </h3>
  {apod ? (
    <button
      id="cosmos-open"
      type="button"
      class="flex flex-1 cursor-pointer flex-col text-left"
      aria-haspopup="dialog"
      aria-controls="cosmos-modal"
    >
      {apod.media_type === 'image' && (
        <img
          src={apod.url}
          alt={apod.title}
          class="mb-3 aspect-video w-full border border-rule-soft object-cover"
          loading="lazy"
        />
      )}
      <h4 class="font-display text-lg font-bold leading-snug">{apod.title}</h4>
      <p class="mt-1 line-clamp-2 text-[0.85rem] leading-relaxed text-ink-soft">
        {apod.explanation}
      </p>
      <p class="mt-auto flex items-baseline justify-between gap-2 pt-3 font-mono text-[0.6rem] uppercase tracking-widest text-ink-soft">
        <span>NASA APOD · {apod.date}</span>
        <span class="text-accent">Click to expand</span>
      </p>
    </button>
  ) : (
    <p class="text-[0.88rem] italic leading-relaxed text-ink-soft">
      The observatory wire is down tonight. The sky, presumably, continues without us.
    </p>
  )}
</article>

{apod && (
  <dialog
    id="cosmos-modal"
    class="cosmos-modal"
    aria-label={`NASA Astronomy Picture of the Day: ${apod.title}`}
  >
    <div class="cosmos-modal-inner">
      <button
        id="cosmos-close"
        type="button"
        class="cosmos-close font-mono text-[0.68rem] uppercase tracking-[0.2em]"
      >
        × Close
      </button>
      <p class="pr-20 font-mono text-[0.62rem] uppercase tracking-[0.25em] text-accent">
        ✦ Cosmos Watch · NASA APOD · {apod.date}
      </p>
      {apod.media_type === 'image' && (
        <img
          src={apod.hdurl ?? apod.url}
          alt={apod.title}
          class="mt-3 w-full border border-rule-soft"
          loading="lazy"
        />
      )}
      <h4 class="mt-4 font-display text-2xl font-bold leading-snug">{apod.title}</h4>
      <p class="mt-3 text-[0.95rem] leading-relaxed">{apod.explanation}</p>
      {apod.copyright && (
        <p class="mt-3 font-mono text-[0.6rem] uppercase tracking-widest text-ink-soft">
          © {apod.copyright.trim()}
        </p>
      )}
    </div>
  </dialog>
)}

<script is:inline>
  (function () {
    var openBtn = document.getElementById('cosmos-open');
    var modal = document.getElementById('cosmos-modal');
    var closeBtn = document.getElementById('cosmos-close');
    if (!openBtn || !modal || typeof modal.showModal !== 'function') return;
    openBtn.addEventListener('click', function () {
      modal.showModal();
    });
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        modal.close();
      });
    }
    // Clicking the backdrop (outside the inner sheet) closes the modal.
    // Escape-to-close is native <dialog> behavior.
    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.close();
    });
  })();
</script>
