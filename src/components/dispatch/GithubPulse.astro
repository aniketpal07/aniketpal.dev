---
import { fetchRecentPushes } from '../../lib/github';

const pushes = await fetchRecentPushes(3);

function fmtDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

function truncate(message: string): string {
  return message.length > 60 ? `${message.slice(0, 60)}…` : message;
}
---

<article class="flex flex-col border border-rule-soft bg-card p-4">
  <h3 class="mb-3 border-b border-rule-soft pb-2 font-mono text-[0.62rem] uppercase tracking-[0.25em]">
    ⦿ GitHub Pulse · Wire Service
  </h3>
  {pushes.length > 0 ? (
    <ul class="flex flex-1 flex-col">
      {pushes.map((p) => (
        <li class="border-b border-rule-soft py-2 last:border-b-0">
          <p class="font-mono text-[0.68rem] font-medium">
            <span class="text-accent">→</span>
            <a href={p.repoUrl} class="text-accent transition-colors hover:underline">
              {p.repoName}
            </a>
          </p>
          <p class="mt-0.5 text-[0.85rem] leading-snug">{truncate(p.message)}</p>
          <p class="mt-0.5 font-mono text-[0.6rem] uppercase tracking-widest text-ink-soft">
            {fmtDate(p.date)}
          </p>
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-[0.88rem] italic leading-relaxed text-ink-soft">
      No recent pushes. The builder is thinking.
    </p>
  )}
</article>
